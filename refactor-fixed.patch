+package it.futurearcana.futurearcanaheroes.common.player;
+
+import net.minecraft.server.level.ServerPlayer;
+import it.futurearcana.futurearcanaheroes.api.capability.PlayerArcanaData;
+import it.futurearcana.futurearcanaheroes.systems.vampire.VampireSystem;
+import it.futurearcana.futurearcanaheroes.systems.lycan.LycanSystem;
+
+public class PlayerHandler {
+
+    private static final VampireSystem VAMPIRE = new VampireSystem();
+    private static final LycanSystem LYCAN = new LycanSystem();
+
+    public static void tick(ServerPlayer player, PlayerArcanaData data) {
+        VAMPIRE.tick(player, data);
+        LYCAN.tick(player, data);
+    }
+}
