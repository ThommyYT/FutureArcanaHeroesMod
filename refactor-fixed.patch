@@ -0,0 +1,22 @@
+package it.futurearcana.futurearcanaheroes.systems.vampire;
+
+import net.minecraft.server.level.ServerPlayer;
+import it.futurearcana.futurearcanaheroes.api.capability.PlayerArcanaData;
+
+public class VampireSystem {
+
+    public void tick(ServerPlayer player, PlayerArcanaData data) {
+
+        if (!"vampire".equals(data.getRace())) return;
+
+        boolean isDay = player.level().isDay();
+
+        if (isDay) {
+            player.hurt(player.damageSources().magic(), 1.0F);
+        } else {
+            data.setMana(Math.min(100, data.getMana() + 1));
+        }
+    }
+}

