+package it.futurearcana.futurearcanaheroes.systems.lycan;
+
+import net.minecraft.server.level.ServerPlayer;
+import it.futurearcana.futurearcanaheroes.api.capability.PlayerArcanaData;
+
+public class LycanSystem {
+
+    public void tick(ServerPlayer player, PlayerArcanaData data) {
+
+        if (!"lycan".equals(data.getRace())) return;
+
+        boolean night = player.level().isNight();
+
+        // NOTE: speed handled later via attribute system (safe refactor step)
+        if (night) {
+            data.setCorruption(data.getCorruption() + 1);
+        }
+    }
+}

